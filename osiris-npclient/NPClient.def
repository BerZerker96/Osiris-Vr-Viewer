; NPClient.def — export table for the Osiris TrackIR bridge DLL.
;
; Assigns the canonical NaturalPoint NPClient ordinals to each export so the
; DLL is a drop-in match for games that import by ordinal as well as by name.
; On 32-bit it ALSO gives the __stdcall functions clean, undecorated names
; (NP_GetData instead of _NP_GetData@4), which games expect from GetProcAddress.
;
; Used by build-npclient.bat via  /link /DEF:NPClient.def

EXPORTS
    NPPriv_ClientNotify          @1
    NPPriv_GetLastError          @2
    NPPriv_SetData               @3
    NPPriv_SetLastError          @4
    NPPriv_SetParameter          @5
    NPPriv_SetSignature          @6
    NPPriv_SetVersion            @7
    NP_GetData                   @8
    NP_GetParameter              @9
    NP_GetSignature              @10
    NP_QueryVersion              @11
    NP_ReCenter                  @12
    NP_RegisterProgramProfileID  @13
    NP_RegisterWindowHandle      @14
    NP_RequestData               @15
    NP_SetParameter              @16
    NP_StartCursor               @17
    NP_StartDataTransmission     @18
    NP_StopCursor                @19
    NP_StopDataTransmission      @20
    NP_UnregisterWindowHandle    @21
